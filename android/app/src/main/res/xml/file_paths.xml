<?xml version="1.0" encoding="utf-8"?>
<!--
  Ce que le FileProvider accepte d'exposer : uniquement les dossiers du cache
  où l'app dépose ce qui doit sortir d'elle — les PDU des MMS en cours d'envoi,
  les fichiers produits par une rédaction (photo prise, vCard exportée, vocal
  enregistré, GIF rapatrié du catalogue), et les copies prêtées à une autre application le temps d'ouvrir
  une pièce jointe.
  Rien d'autre du stockage de l'app n'est atteignable par ce biais.
-->
<paths>
    <cache-path name="mms" path="mms/"/>
    <cache-path name="captures" path="captures/"/>
    <cache-path name="shared" path="shared/"/>
    <cache-path name="voice" path="voice/"/>
    <cache-path name="gifs" path="gifs/"/>
</paths>
