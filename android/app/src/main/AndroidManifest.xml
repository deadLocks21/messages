<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lecture/écriture du stock SMS. RECEIVE_SMS est indispensable pour
         obtenir SMS_DELIVER une fois l'app définie par défaut. -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_MMS"/>
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Envoi d'un MMS : le PDU part vers le MMSC par le réseau de données de
         l'opérateur, que le service MMS du système active à la demande. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Message vocal. Demandée au moment du geste, jamais à l'accueil avec les
         SMS : qui n'envoie pas de vocal n'a aucune raison d'accorder son micro
         à une application de SMS. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:label="Messages"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Les intents `sms:` ne sont pas des liens profonds. Sans ce
                 réglage, l'embarqueur Flutter passe la donnée de l'intent au
                 `Router` comme route initiale : `go_router` reçoit
                 `sms:0612345678`, un chemin qui ne commence pas par `/`, et
                 casse au premier build (assertion) ou tombe sur l'écran
                 d'erreur en release. Ces intents sont lus par `SmsBridge`
                 (`consumeLaunchRequest`/`onNewIntent`), qui sait, lui, en tirer
                 le fil à ouvrir. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Composant 1/4 exigé pour tenir le rôle d'app SMS par défaut :
                 savoir ouvrir un sms:/smsto: venu d'une autre application. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SENDTO"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
            </intent-filter>
        </activity>

        <!-- Composant 2/4 : réception des SMS. Seule l'app par défaut reçoit
             SMS_DELIVER, et c'est elle qui doit écrire le message dans le
             stock — le système ne le fait plus à sa place. -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER"/>
            </intent-filter>
        </receiver>

        <!-- Composant 3/4 : réception des MMS. Seule l'app par défaut reçoit
             WAP_PUSH_DELIVER, et ce qu'elle en laisse tomber est perdu —
             aucune autre application ne prend le relais. -->
        <receiver
            android:name=".MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER"/>
                <data android:mimeType="application/vnd.wap.mms-message"/>
            </intent-filter>
        </receiver>

        <!-- Issue d'un envoi : dépôt réseau du SMS, remise au destinataire,
             dépôt du MMS auprès du MMSC. Déclaré au manifeste, et non
             enregistré à chaud par l'Activity : l'accusé arrive après un
             aller-retour réseau, souvent alors que l'utilisateur a déjà quitté
             l'application — c'est justement là qu'un échec doit se signaler. -->
        <receiver
            android:name=".SmsSendStatusReceiver"
            android:exported="false"/>

        <!-- Issue du téléchargement du MMS auprès du MMSC. Déclaré au
             manifeste : entre l'annonce et la descente il s'écoule un
             aller-retour réseau, pendant lequel l'app peut ne plus tourner —
             un receveur enregistré à chaud ne serait plus là pour l'accusé. -->
        <receiver
            android:name=".MmsDownloadedReceiver"
            android:exported="false"/>

        <!-- Actions des notifications (réponse directe, marquer comme lu).
             Déclaré au manifeste : il doit répondre même app non lancée. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false"/>

        <!-- Composant 4/4 : réponse rapide depuis l'écran d'appel entrant. -->
        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
            </intent-filter>
        </service>

        <!-- Les pièces jointes sortantes passent par des fichiers de notre
             cache : le PDU d'un MMS, la photo que l'appareil vient de prendre,
             la vCard d'un contact. Le service MMS du système et l'application
             appareil photo les ouvrent sous *leur* identité — un chemin de
             fichier ne leur suffirait pas, il leur faut une URI de contenu. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Bouton « Appeler » d'un fil (url_launcher, tel:). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Sélecteurs de pièces jointes : sans ces déclarations, Android 11+
             répondrait « aucune application » à la résolution de l'intent. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK"/>
        </intent>
    </queries>
</manifest>
